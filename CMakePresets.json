{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "TINYKV_COMPILE_JOBS": "8",
                "TINYKV_LINK_JOBS": "2"
            }
        },
        {
            "name": "win-debug",
            "inherits": "base",
            "displayName": "Windows · MSYS2 ucrt64 g++ · Debug",
            "description": "要求 PATH 含 MSYS2 ucrt64（gcc/g++/ninja），否则不可用",
            "environment": {
                "CC": "gcc",
                "CXX": "g++"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "win-release",
            "inherits": "win-debug",
            "displayName": "Windows · MSYS2 ucrt64 g++ · Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "win-slim",
            "inherits": "win-debug",
            "displayName": "Windows · MSYS2 ucrt64 g++ · Debug(省磁盘)",
            "description": "-g1：只保留文件/行号，产物约减半；info locals 不可用，深度调试请用 win-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TINYKV_MIN_DEBUG": "ON"
            }
        },
        {
            "name": "linux-debug",
            "inherits": "base",
            "displayName": "Linux · 系统 g++ · Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "inherits": "linux-debug",
            "displayName": "Linux · 系统 g++ · Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "win-vcpkg",
            "inherits": "win-debug",
            "displayName": "Windows · vcpkg 依赖 · Debug",
            "description": "依赖走 vcpkg 清单（vcpkg.json）；要求已设置 VCPKG_ROOT",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "linux-vcpkg",
            "inherits": "linux-debug",
            "displayName": "Linux · vcpkg 依赖 · Debug",
            "description": "依赖走 vcpkg 清单（vcpkg.json）；要求已设置 VCPKG_ROOT",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "win-cxx20",
            "inherits": "win-debug",
            "displayName": "Windows · g++ · Debug（C++20）",
            "description": "原生 std::expected 可用，验证 20 档兼容",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TINYKV_CXX_STANDARD": "20"
            }
        },
        {
            "name": "win-cxx17",
            "inherits": "win-debug",
            "displayName": "Windows · g++ · Debug（C++17）",
            "description": "compat.h 兜底档：验证 expected/span/starts_with 替代实现",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TINYKV_CXX_STANDARD": "17"
            }
        },
        {
            "name": "linux-cxx20",
            "inherits": "linux-debug",
            "displayName": "Linux · g++ · Debug（C++20）",
            "description": "原生 std::expected 可用，验证 20 档兼容",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TINYKV_CXX_STANDARD": "20"
            }
        },
        {
            "name": "linux-cxx17",
            "inherits": "linux-debug",
            "displayName": "Linux · g++ · Debug（C++17）",
            "description": "compat.h 兜底档：验证 expected/span/starts_with 替代实现",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TINYKV_CXX_STANDARD": "17"
            }
        },
        {
            "name": "win-clang23",
            "inherits": "base",
            "displayName": "Windows · clang++ · Debug（C++23）",
            "description": "第二编译器：验证 MSYS2 clang++ 下同一套源码与告警基线",
            "environment": {
                "CC": "clang",
                "CXX": "clang++"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TINYKV_CXX_STANDARD": "23"
            }
        },
        {
            "name": "linux-clang23",
            "inherits": "base",
            "displayName": "Linux · clang++ · Debug（C++23）",
            "description": "第二编译器：验证 clang++ 下同一套源码与告警基线",
            "environment": {
                "CC": "clang",
                "CXX": "clang++"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TINYKV_CXX_STANDARD": "23"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "win-debug",
            "configurePreset": "win-debug"
        },
        {
            "name": "win-release",
            "configurePreset": "win-release"
        },
        {
            "name": "win-slim",
            "configurePreset": "win-slim"
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "win-vcpkg",
            "configurePreset": "win-vcpkg"
        },
        {
            "name": "linux-vcpkg",
            "configurePreset": "linux-vcpkg"
        },
        {
            "name": "win-cxx20",
            "configurePreset": "win-cxx20"
        },
        {
            "name": "win-cxx17",
            "configurePreset": "win-cxx17"
        },
        {
            "name": "linux-cxx20",
            "configurePreset": "linux-cxx20"
        },
        {
            "name": "linux-cxx17",
            "configurePreset": "linux-cxx17"
        },
        {
            "name": "win-clang23",
            "configurePreset": "win-clang23"
        },
        {
            "name": "linux-clang23",
            "configurePreset": "linux-clang23"
        }
    ],
    "testPresets": [
        {
            "name": "win-debug",
            "configurePreset": "win-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "win-release",
            "configurePreset": "win-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "win-slim",
            "configurePreset": "win-slim",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "win-vcpkg",
            "configurePreset": "win-vcpkg",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-vcpkg",
            "configurePreset": "linux-vcpkg",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "win-cxx20",
            "configurePreset": "win-cxx20",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "win-cxx17",
            "configurePreset": "win-cxx17",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-cxx20",
            "configurePreset": "linux-cxx20",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-cxx17",
            "configurePreset": "linux-cxx17",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "win-clang23",
            "configurePreset": "win-clang23",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-clang23",
            "configurePreset": "linux-clang23",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
